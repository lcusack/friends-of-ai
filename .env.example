# World ID (from https://developer.worldcoin.org)
NEXT_PUBLIC_WORLDCOIN_APP_ID=app_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_WORLDCOIN_ACTION=friend-of-ai

# Canonical URL — baked into receipts and invite links.
# Local dev: http://localhost:3000
# Vercel preview: https://your-project.vercel.app
NEXT_PUBLIC_CANONICAL_URL=http://localhost:3000

# HMAC secret used to sign Human Receipts. ROTATE = all old signatures invalid.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECEIPT_HMAC_SECRET=change-me-to-a-long-random-string

# Set to 1 for local dev to bypass real World ID verification.
# NEVER set in production. The server refuses to honor this when VERCEL_ENV=production.
MOCK_WORLDID=0

# Storage backend. Set automatically by Vercel KV integration.
# If KV_REST_API_URL is present, the app uses KV. Otherwise it falls back to
# data/data.json (fine for local dev, broken on Vercel due to ephemeral fs).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional — not currently wired. For Sign-in-with-WorldID / RP-signed flows.
# WORLDCOIN_RP_ID=rp_xxxxxxxxxxxxxxxx
# WORLDCOIN_RP_PRIVATE_KEY=0xabc...
